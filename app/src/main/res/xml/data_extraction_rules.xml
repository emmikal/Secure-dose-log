<?xml version="1.0" encoding="utf-8"?>

<data-extraction-rules>

    <!--
        Secure Dose Log stores sensitive dose/substance information locally.

        Do not include the encrypted database or encrypted preferences
        in Android cloud backups.
    -->
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>

    <!--
        Do not transfer the database or encrypted preferences during
        device-to-device migration either.
    -->
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>

</data-extraction-rules>